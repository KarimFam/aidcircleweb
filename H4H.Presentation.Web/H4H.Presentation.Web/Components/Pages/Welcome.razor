@page "/welcome"
@attribute [AllowAnonymous]
@layout PublicLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<PageTitle>Welcome to AidCircle</PageTitle>

<div class="welcome-page">
    <AuthorizeView>
        <Authorized>
            @* Redirect authenticated users to dashboard - handled in OnInitialized *@
        </Authorized>
        <NotAuthorized>
            @* Hero Section *@
            <section class="hero-section">
                <div class="ac-container">
                    <div class="hero-content">
                        <div class="hero-text">
                            <h1 class="hero-title">
                                Connecting Communities<br />
                                <span class="hero-title-accent">One Act of Kindness</span><br />
                                at a Time
                            </h1>
                            <p class="hero-description">
                                AidCircle brings together volunteers, organizations, and communities to streamline 
                                resource coordination and make meaningful impact where it matters most.
                            </p>
                            <div class="hero-cta">
                                <a href="MicrosoftIdentity/Account/SignIn" class="ac-btn ac-btn-primary ac-btn-lg">
                                    Get Started
                                </a>
                                <a href="#learn-more" class="ac-btn ac-btn-outline ac-btn-lg">
                                    Learn More
                                </a>
                            </div>
                            <div class="hero-stats">
                                <div class="stat-item">
                                    <div class="stat-number">10K+</div>
                                    <div class="stat-label">Volunteers</div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-number">500+</div>
                                    <div class="stat-label">Organizations</div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-number">50K+</div>
                                    <div class="stat-label">Items Distributed</div>
                                </div>
                            </div>
                        </div>
                        <div class="hero-image">
                            <div class="hero-image-placeholder">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @* Mission Section *@
            <section id="learn-more" class="mission-section ac-section">
                <div class="ac-container">
                    <div class="section-header ac-text-center">
                        <h2 class="ac-heading-2">Our Mission</h2>
                        <p class="ac-text-body" style="max-width: 700px; margin: 0 auto;">
                            Empowering communities through transparent, efficient coordination of resources and volunteers.
                            We believe in the power of collective action to create lasting positive change.
                        </p>
                    </div>
                </div>
            </section>

            @* Features Section *@
            <section class="features-section ac-section" style="background: var(--ac-white);">
                <div class="ac-container">
                    <div class="section-header ac-text-center ac-mb-xl">
                        <h2 class="ac-heading-2">How AidCircle Works</h2>
                    </div>
                    
                    <div class="ac-grid ac-grid-cols-1 ac-grid-cols-md-3">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                            </div>
                            <h3 class="feature-title">Connect Volunteers</h3>
                            <p class="feature-description">
                                Match skilled volunteers with organizations and causes they care about. 
                                Track hours, skills, and impact.
                            </p>
                        </div>

                        <div class="feature-card">
                            <div class="feature-icon feature-icon-secondary">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </div>
                            <h3 class="feature-title">Manage Resources</h3>
                            <p class="feature-description">
                                Efficiently track items, orders, and distributions. Ensure resources 
                                reach those who need them most.
                            </p>
                        </div>

                        <div class="feature-card">
                            <div class="feature-icon feature-icon-accent">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                </svg>
                            </div>
                            <h3 class="feature-title">AI-Powered Chat</h3>
                            <p class="feature-description">
                                Get instant help in 11 languages. Our AI assistant guides you through 
                                the platform and answers questions 24/7.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            @* CTA Section *@
            <section class="cta-section ac-section">
                <div class="ac-container">
                    <div class="cta-card">
                        <h2 class="ac-heading-2 ac-text-center" style="color: var(--ac-white);">
                            Ready to Make a Difference?
                        </h2>
                        <p class="ac-text-body ac-text-center" style="color: var(--ac-gray-100); max-width: 600px; margin: 0 auto var(--ac-space-xl);">
                            Join thousands of volunteers and organizations already making an impact through AidCircle.
                        </p>
                        <div class="ac-flex ac-justify-center ac-gap-md">
                            <a href="MicrosoftIdentity/Account/SignIn" class="ac-btn ac-btn-lg" style="background: var(--ac-white); color: var(--ac-primary);">
                                Sign In
                            </a>
                            <a href="MicrosoftIdentity/Account/SignIn" class="ac-btn ac-btn-lg ac-btn-outline" style="border-color: var(--ac-white); color: var(--ac-white);">
                                Create Account
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            @* Footer *@
            <footer class="welcome-footer">
                <div class="ac-container">
                    <div class="footer-content">
                        <div class="footer-brand">
                            <h3 style="color: var(--ac-white); margin: 0 0 var(--ac-space-sm);">AidCircle</h3>
                            <p class="ac-text-small" style="color: var(--ac-gray-400);">
                                Connecting communities, one act of kindness at a time.
                            </p>
                        </div>
                        <div class="footer-links">
                            <a href="#" class="footer-link">About</a>
                            <a href="#" class="footer-link">Privacy</a>
                            <a href="#" class="footer-link">Terms</a>
                            <a href="#" class="footer-link">Contact</a>
                        </div>
                    </div>
                    <div class="footer-bottom">
                        <p class="ac-text-small" style="color: var(--ac-gray-500); margin: 0;">
                            © @DateTime.Now.Year AidCircle. All rights reserved.
                        </p>
                    </div>
                </div>
            </footer>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AuthenticationStateTask != null)
        {
            var authState = await AuthenticationStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // Redirect authenticated users to home (must use forceLoad to avoid NavigationException)
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
    }
}
